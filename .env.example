# Runtime mode
NODE_ENV=development
LOG_LEVEL=info

# Starknet testnet integration
STARKNET_NETWORK=sepolia
STARKNET_CHAIN_ID=
STARKNET_RPC_PRIMARY_URL=
STARKNET_RPC_PRIMARY_OPERATOR=
STARKNET_RPC_SECONDARY_URL=
STARKNET_RPC_SECONDARY_OPERATOR=
STRK20_POOL_ADDRESS=
STRK20_POOL_CLASS_HASH=
STRK20_POOL_VERSION=
# Public deployment declaration; SHA-256 is lowercase hex over the exact manifest bytes.
STRK20_POOL_DEPLOYMENT_TRANSACTION_REFERENCE=
STRK20_POOL_DEPLOYMENT_MANIFEST_URL=
STRK20_POOL_DEPLOYMENT_MANIFEST_SHA256=
STRK20_USDC_TOKEN_ADDRESS=
STRK20_USDC_TOKEN_CLASS_HASH=
STRK20_USDC_TOKEN_VERSION=
# Public deployment declaration; do not put URL credentials or private operator data here.
STRK20_USDC_TOKEN_DEPLOYMENT_TRANSACTION_REFERENCE=
STRK20_USDC_TOKEN_DEPLOYMENT_MANIFEST_URL=
STRK20_USDC_TOKEN_DEPLOYMENT_MANIFEST_SHA256=
STRK20_DISCOVERY_URL=
STRK20_DISCOVERY_OPERATOR=
STRK20_DISCOVERY_VERSION=
STRK20_PROVING_URL=
STRK20_PROVING_OPERATOR=
STRK20_PROVING_VERSION=
STRK20_PROOF_INTERCEPTOR_URL=
STRK20_PROOF_INTERCEPTOR_OPERATOR=
STRK20_PROOF_INTERCEPTOR_VERSION=
STRK20_SCREENING_PROVIDER_URL=
STRK20_SCREENING_PROVIDER_OPERATOR=
STRK20_SCREENING_RPC_PROVIDER_ID=
STRK20_SCREENING_POOL_ADDRESS=
STRK20_SCREENING_POLICY=
STRK20_SCREENING_BLOCK_NON_POOL_TRANSACTIONS=
STRK20_SCREENING_FAIL_OPEN=
STRK20_PROVER_SCREENING_FAIL_OPEN=
STRK20_WALLET_API_VERSION=
STARKNET_FINALITY_POLICY=
STARKNET_PROVING_BLOCKS_BEHIND=
STARKNET_MINIMUM_REMAINING_VALIDITY_BLOCKS=
STARKNET_MAXIMUM_HEAD_LAG_BLOCKS=
STARKNET_MAXIMUM_BLOCK_AGE_SECONDS=
STARKNET_MAXIMUM_FUTURE_BLOCK_TIME_SECONDS=
STARKNET_RPC_REQUEST_TIMEOUT_MILLISECONDS=
TESTNET_ACCOUNT_CONFIRMED=false
TESTNET_FUNDS_CAPPED=false

# Settlement account public metadata
SETTLEMENT_ACCOUNT_ADDRESS=
SETTLEMENT_ACCOUNT_CLASS_HASH=
SETTLEMENT_ACCOUNT_VERSION=

# Secret values must be supplied through the local environment or a secret manager.
SETTLEMENT_SIGNER_PRIVATE_KEY=
SETTLEMENT_VIEWING_KEY=
STRK20_SCREENING_PARTNER_NAME=
STRK20_SCREENING_PARTNER_SECRET=

# Service wiring
SETTLEMENT_BIND_HOST=127.0.0.1
SETTLEMENT_PORT=9080
DATABASE_URL=
