{
  "name": "cashu-strk20-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Cashu payment infrastructure backed by private STRK20 settlement on Starknet",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.28 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm check:typescript && pnpm check:rust && pnpm docs:links",
    "check:rust": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "check:typescript": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "docs:links": "node scripts/check-doc-links.mjs",
    "format": "biome format --write packages services",
    "format:check": "biome format packages services",
    "lint": "biome lint packages services",
    "precommit": "scripts/check-protected-paths.sh && pnpm check",
    "privacy-sdk:verify-artifact": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/verify-privacy-sdk-artifact.mjs",
    "privacy-sdk:verify-artifact-ports": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/verify-privacy-sdk-artifact-ports.mjs",
    "privacy-sdk:verify-source-build": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/verify-privacy-sdk-source-build.mjs",
    "privacy-sdk:verify-source-ports": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/verify-privacy-sdk-source-ports.mjs",
    "privacy-services:verify-images": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/verify-privacy-service-images.mjs",
    "rust:fmt": "cargo fmt --all --check",
    "rust:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace --all-targets",
    "testnet:observe-integration": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-observe-integration.mjs",
    "testnet:plan-pool-deployment": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-plan-pool-deployment.mjs",
    "testnet:preflight": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-preflight.mjs",
    "testnet:validate-evidence": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-validate-evidence.mjs",
    "testnet:verify-context": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-verify-context.mjs",
    "testnet:verify-deployment": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-verify-deployment.mjs",
    "testnet:verify-services": "pnpm --silent --filter @cashu-strk20/strk20-method --filter @cashu-strk20/settlement run build && node --conditions=cashu-strk20-compiled scripts/testnet-verify-services.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
